# =============================================================================
# SHESA PORTAL - ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and configure the required values.
#
# cp .env.example .env
#
# NEVER commit .env or real credentials to version control.
# Generate unique secrets for every environment.
# =============================================================================


# =============================================================================
# 1. DJANGO CONFIGURATION
# =============================================================================

DJANGO_SETTINGS_MODULE=config.settings.production

# Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=dc1fb71e0c04cc021640ef0c928eaae941befb108d81af7bdeb737e1668c245dd012a49630f29a26194f782c054981034686006d5ecd6800a366b825f1c33dd3

DJANGO_DEBUG=false

ALLOWED_HOSTS=localhost,127.0.0.1

PUBLIC_APP_URL=http://localhost:8000

LOG_LEVEL=INFO

SECURE_SSL_REDIRECT=false


# =============================================================================
# 2. DATABASE - POSTGRESQL
# =============================================================================

DB_NAME=shesa_portal
DB_USER=shesa
DB_PASSWORD=D4e3726p,
DB_HOST=localhost
DB_PORT=5432

# For local SQLite development, configure your application accordingly.


# =============================================================================
# 3. AUTHENTICATION - OIDC / AUTHENTIK
# =============================================================================

USE_SSO=true

OIDC_PROVIDER_ID=authentik
OIDC_PROVIDER_NAME=Shesa SSO

OIDC_CLIENT_ID=shesa-portal-client
OIDC_CLIENT_SECRET=68d1cc0c1f56e10ffb2a0f2b0fae2b2ac95dc70a79f412bc2d380c9f75a21217cc098c0d399fbeafb82c0095d35d07e90fbd832543e13b9315893a342c5dd16d

OIDC_SERVER_URL=http://sso.shesa.local:9000/application/o/shesa/

OIDC_REDIRECT_URI=http://localhost:8000/accounts/oidc/authentik/login/callback/

LOGIN_REDIRECT_URL=/index.html


# =============================================================================
# 4. DEVELOPMENT AUTHENTICATION
# =============================================================================
# Used when USE_SSO=false.

DEV_USER_EMAIL=developer@localhost


# =============================================================================
# 5. AUTHENTIK - LOCAL DEPLOYMENT
# =============================================================================
# Used by docker-compose.authentik.yml.
#
# Generate secrets with:
# python -c "import secrets; print(secrets.token_urlsafe(50))"

AUTHENTIK_SECRET_KEY=68d1cc0c1f56e10ffb2a0f2b0fae2b2ac95dc70a79f412bc2d380c9f75a21217cc098c0d399fbeafb82c0095d35d07e90fbd832543e13b9315893a342c5dd16d

AUTHENTIK_PG_PASS=D4e3726p,

AUTHENTIK_BOOTSTRAP_PASSWORD=D4e3726p,
AUTHENTIK_BOOTSTRAP_EMAIL=admin@shesa.local

# Pin compatible Authentik versions for deployment.
AUTHENTIK_IMAGE=ghcr.io/goauthentik/server:2024.12.5
AUTHENTIK_OUTPOST=ghcr.io/goauthentik/server:2024.12.3

AUTHENTIK_API_URL=http://sso.shesa.local:9000
AUTHENTIK_API_TOKEN=28ZNB9dco5crbMAYkXdA11DLjwGWvd4XmJf2M8Os99K0YEzcsZVqWeKCzjAb

AUTHENTIK_DEFAULT_GROUP=
AUTHENTIK_ADMIN_GROUP=


# =============================================================================
# 6. WIREGUARD / OPNSENSE
# =============================================================================

OPNSENSE_URL=http://localhost:8443

OPNSENSE_API_KEY=dummy-api-key
OPNSENSE_API_SECRET=dummy-api-secret

WG_INSTANCE_UUID=dummy-instance-uuid

WG_ENDPOINT=127.0.0.1
WG_PORT=51820

WG_SUBNET=10.10.10.0/24
WG_DNS=8.8.8.8

ALLOWED_IPS_CLIENT=10.10.10.0/24

# Enable certificate verification in production.
VERIFY_SSL=true


# =============================================================================
# 7. SYNOLOGY NAS
# =============================================================================
# Leave empty when NAS integration is disabled.

DSM_URL=
DSM_ADMIN_USER=
DSM_ADMIN_PASS=

DSM_SHARE_GROUP=staff
DSM_ADMIN_GROUP=staff

NAS_IP=
NAS_SHARE_NAME=

LAUNCHER_TOKEN_TTL_MINUTES=60


# =============================================================================
# 8. EMAIL / SMTP
# =============================================================================
# Optional: configure to enable welcome emails and other notifications.

SMTP_SERVER=
SMTP_PORT=465

SMTP_USER=
SMTP_PASSWORD=

SENDER_EMAIL=

COMPANY_NAME=SHESA S.r.l.


# =============================================================================
# 9. LEGACY SQLITE IMPORT
# =============================================================================
# Used exclusively by:
# python manage.py import_sqlite

LEGACY_SQLITE_PATH=


# =============================================================================
# 10. SANITY CMS
# =============================================================================

SANITY_PROJECT_ID=zwunc5gi
SANITY_DATASET=production
SANITY_API_VERSION=2026-01-01

# Requires a Sanity API token with appropriate permissions.
SANITY_WRITE_TOKEN=CHANGE_ME


# =============================================================================
# 11. SANITY CMS SYNCHRONIZATION
# =============================================================================

SANITY_SYNC_ENABLED=true

SANITY_SYNC_TIME=03:00

SANITY_RETRY_INTERVAL_MINUTES=5
SANITY_MAX_ATTEMPTS=20


# =============================================================================
# 12. FEATURE FLAGS
# =============================================================================

# Enables:
# - Leave (PTO) API endpoints
# - Leave navigation links
# - Dashboard leave widgets
# - Admin leave approvals
# - Leave calendar

LEAVE_MANAGEMENT_ENABLED=true


# =============================================================================
# 13. LEAVE MANAGEMENT DEFAULTS
# =============================================================================
# Used when a year's leave balance is first created.

LEAVE_DEFAULT_VACATION_DAYS=26
LEAVE_DEFAULT_SICK_DAYS=10
LEAVE_DEFAULT_PERSONAL_DAYS=4
